# ─────────────────────────────────────────────────────────────
#  Fireground Trainer — environment configuration
#  Copy this file to .env and fill in your values.
#  Never commit a real .env file to version control.
# ─────────────────────────────────────────────────────────────


# ── Required ──────────────────────────────────────────────────

# Flask session secret. Generate a strong random value before any real use:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-before-pilot


# ── Database ──────────────────────────────────────────────────

# SQLite (default, fine for laptop demos at the station):
DATABASE_URL=sqlite:///instance/fireground_trainer.db

# PostgreSQL (use this when moving to Railway or any real server):
# DATABASE_URL=postgresql://user:password@host:5432/fireground_trainer


# ── Network ───────────────────────────────────────────────────

# The publicly reachable URL of this machine — used for QR codes and join links.
# For the laptop pilot, set this to your laptop's LAN IP, e.g.:
#   PUBLIC_BASE_URL=http://192.168.1.42:5000
# Leave blank to auto-detect (works for simple setups, may be wrong on multi-NIC machines).
PUBLIC_BASE_URL=

# Dev server bind address and port.
RUN_HOST=0.0.0.0
RUN_PORT=5000

# Debug mode — leave OFF for any real session with participants.
# Enables the Werkzeug interactive debugger, which exposes your server internals.
RUN_DEBUG=0


# ── Demo / seed data ──────────────────────────────────────────

# Create demo staff accounts on first startup (instructor@demo.local, etc.).
# Set to 0 once you have real instructor accounts and don't want the demo logins.
ENABLE_DEMO_SEED_USERS=1

# Password for the demo staff accounts created above.
DEMO_BOOTSTRAP_PASSWORD=EasyPass123

# Create the built-in fireground scenarios on first startup.
# Set to 0 if you want a clean slate with no pre-loaded content.
ENABLE_DEMO_SEED_SCENARIOS=1


# ── Image uploads ─────────────────────────────────────────────

# Where uploaded scenario images are stored.
# Defaults to the "static/uploads" folder in the project (fine for local use).
# On Railway, set this to the Railway Volume mount path so uploads survive deploys:
#   UPLOAD_FOLDER=/data/uploads
# NOTE: If UPLOAD_FOLDER differs from static/uploads, uploaded files are served
# via /uploads/<filename>. Leave blank to use the default (static/uploads).
UPLOAD_FOLDER=


# ── Auth / security ───────────────────────────────────────────

# Show magic-link tokens directly in the UI (handy while email delivery isn't set up).
# Set to 0 when real users are signing in so tokens aren't visible on screen.
ENABLE_MAGIC_LINK_DEBUG=1

# How long a magic link stays valid (minutes).
MAGIC_LINK_TTL_MINUTES=15

# Show account activation links directly in the UI (same as above — debug convenience).
# Set to 0 for any real deployment.
ENABLE_ACCOUNT_ACTIVATION_DEBUG=1

# How long an account activation link stays valid (hours).
ACCOUNT_ACTIVATION_TTL_HOURS=24

# Set to 1 when serving over HTTPS so cookies are marked Secure.
# Leave 0 for the local laptop pilot (no HTTPS).
SESSION_COOKIE_SECURE=0
